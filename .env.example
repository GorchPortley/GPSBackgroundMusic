# Google Maps Platform API key with the "Places API (New)" enabled.
# Leave this blank (or delete .env entirely) to run on the built-in offline
# mock provider — the app is fully playable without a key.
GOOGLE_MAPS_API_KEY=

# HTTP port for the local server.
PORT=8787

# Radius in metres for the nearby-places lookup that feeds the music.
PLACES_RADIUS=350

# Set to 0 to force plain HTTP even when certs/ exists. Use this when
# something else terminates TLS in front (tailscale serve, cloudflared,
# a reverse proxy) — those expect a plain HTTP backend.
HTTPS=

# Which nearby-places source to use.
#   auto   (default) Google if GOOGLE_MAPS_API_KEY is set, otherwise OpenStreetMap
#   osm    OpenStreetMap Overpass — free, no key, no account
#   google Places API (New) — needs a key and billing
#   mock   generated offline data, for development
PLACES_PROVIDER=

# Override the Overpass endpoint (e.g. a self-hosted instance).
OVERPASS_URL=
